# Token de API de Smartsheet: Cuenta > Personal Settings > API Access. Obligatorio.
SMARTSHEET_ACCESS_TOKEN=
# Región de la cuenta: https://api.smartsheet.com/2.0 (EE. UU.), .eu o .au
SMARTSHEET_BASE_URL=https://api.smartsheet.com/2.0
# Hosts HTTP aceptados por el backend, separados por comas.
APP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Orígenes web autorizados para modificar permisos, separados por comas.
APP_ALLOWED_ORIGINS=http://localhost:5710,http://127.0.0.1:5710,http://localhost:8710,http://127.0.0.1:8710
# Modo solo lectura: true rechaza toda escritura (dar, cambiar, quitar acceso) antes de llamar a Smartsheet.
APP_READ_ONLY=true
# Ids de hojas que tienen Dynamic View (la API no lo informa), separados por comas.
APP_DYNAMIC_VIEW_SHEETS=
# Carga de diseñadores (SPEC-B12). Estados separados por comas que no cuentan como trabajo abierto.
APP_DESIGNER_COLUMNS=Designer1,Designer2
APP_STATUS_COLUMN=Project Status
APP_CLOSED_STATUSES=CANCELLED,COMPLETE,8. Process completed,4. Permit Cancelled,4. Permit Closed,4. No Permit Required,NO PERMIT REQUIRED
# Hoja catálogo de diseñadores (id) y su columna; vacío para no revisar el catálogo.
APP_DESIGNER_CATALOG_SHEET=
APP_DESIGNER_CATALOG_COLUMN=Designer
