# Token de API de Smartsheet: Cuenta > Personal Settings > API Access. Obligatorio.
SMARTSHEET_ACCESS_TOKEN=
# Región de la cuenta: https://api.smartsheet.com/2.0 (EE. UU.), .eu o .au
SMARTSHEET_BASE_URL=https://api.smartsheet.com/2.0
# Hosts HTTP aceptados por el backend, separados por comas.
APP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Orígenes web autorizados para modificar permisos, separados por comas.
APP_ALLOWED_ORIGINS=http://localhost:5710,http://127.0.0.1:5710,http://localhost:8710,http://127.0.0.1:8710
# Modo solo lectura: true rechaza toda escritura (dar, cambiar, quitar acceso) antes de llamar a Smartsheet.
APP_READ_ONLY=true
# Clave independiente para consultar el ID Manager en Swagger (no es el token de Smartsheet).
IDS_ADMIN_TOKEN=
# Procesador opcional: sólo simula, nunca habilita escrituras.
IDS_MONITOR_ENABLED=false
IDS_MONITOR_INTERVAL_SECONDS=60
# Cada cuántos segundos se revisa si la hoja cambió para adelantar el ciclo; 0 lo desactiva.
IDS_MONITOR_POLL_SECONDS=5
# Barreras para una prueba futura, después de aprobar rangos y escritura expresamente.
IDS_WRITES_ENABLED=false
IDS_TRANSITION_APPROVED=false
# Objeto JSON de ámbitos a primer consecutivo aprobado; no poner valores sin aprobación.
IDS_APPROVED_STARTS={}
# Procesador con asignación real (además de las tres barreras anteriores); tope de filas por ciclo.
IDS_PROCESSOR_WRITES_ENABLED=false
IDS_PROCESSOR_MAX_ROWS=5
# Cambio de cliente: ID nuevo para la madre, hijas de otro cliente fuera (SPEC-ID01 ID-44).
# Exige la migración 005.
IDS_CUSTOMER_CHANGE_ENABLED=false
# Hoja catálogo de proyectos (Pruebas) para el desplegable vinculado de Linked Tracking; vacío = sin sincronizar.
APP_PROJECT_CATALOG_SHEET=
# Copia los comentarios de cada fila a la columna Obs (SPEC-B17); exige las barreras de escritura.
APP_OBS_SYNC_ENABLED=false
APP_OBS_COLUMN=Obs
APP_OBS_TIMEZONE=America/Lima
APP_OBS_INTERVAL_SECONDS=30
APP_OBS_MAX_ROWS=20
# Ids de hojas que tienen Dynamic View (la API no lo informa), separados por comas.
APP_DYNAMIC_VIEW_SHEETS=
# Carga de diseñadores (SPEC-B12). Estados separados por comas que no cuentan como trabajo abierto.
APP_DESIGNER_COLUMNS=Designer1,Designer2
APP_STATUS_COLUMN=Project Status
APP_CLOSED_STATUSES=CANCELLED,COMPLETE,8. Process completed,4. Permit Cancelled,4. Permit Closed,4. No Permit Required,NO PERMIT REQUIRED
# Hoja catálogo de diseñadores (id) y su columna; vacío para no revisar el catálogo.
APP_DESIGNER_CATALOG_SHEET=
APP_DESIGNER_CATALOG_COLUMN=Designer
